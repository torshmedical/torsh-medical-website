{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "torsh-contact-service",
  "main": "src/index.js",
  "compatibility_date": "2026-10-21",
  "workers_dev": false,
  "routes": [
    { "pattern": "torshmedical.com/api/*", "zone_name": "torshmedical.com" },
    { "pattern": "www.torshmedical.com/api/*", "zone_name": "torshmedical.com" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "torsh-enquiries",
      "database_id": "bdf7d2d3-04be-4b48-9ed8-3f5f59964b36"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MAIL_STORE",
      "id": "7b67e3f2287b47dbabf73d4bb118c915"
    }
  ],
  // Email Routing triggers are managed in the Cloudflare dashboard. Keeping
  // them out of Git deployments lets the narrowly scoped build token deploy
  // code without permission to rewrite account-wide email routing rules.
  "vars": {
    "ADMIN_EMAILS": "victor@torshmedical.com,krishna@torshmedical.com,admin@torshmedical.com,info@torshmedical.com",
    "BREVO_SENDER_EMAIL": "info@torshmedical.com",
    "CONTACT_RECIPIENT": "info@torshmedical.com",
    "MAILBOX_EMAILS": "victor@torshmedical.com,krishna@torshmedical.com,admin@torshmedical.com,info@torshmedical.com",
    "MAIL_FORWARD_ADDRESS": "torshmedical@gmail.com"
  }
}
